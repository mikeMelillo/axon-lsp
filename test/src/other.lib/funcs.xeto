+Funcs {

  mikeConcat: Func { a: Str, b: Str, returns: Str 
  
    <axon:---
        
        data: a + b
        newString: wrapper(5,"data")

        wrapper()

        hisData: hisRead()

        points: readAll(point and discharge and air and temp, "opts")

        myList: ["a","b","c"]

        info: toGrid(myList).round()
        x: round(toGrid(myList)).toStr()

        myString: "llama"

        myString.wrapper(a.parseNumber())

                
        
    --->
  }

  wrapper: Func {foo: Str, bar: Number, returns: Str
  
    <axon:---

        return foo
        
    --->

  }

}