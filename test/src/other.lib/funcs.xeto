+Funcs {

  mikeConcat: Func { a: Str, b: Str, returns: Str 
  
    <axon:---
        
        data: a + b
        newString: wrapper("data","lala")

        wrapper()

        hisData: hisRead()

        points: readAll(point and discharge and air and temp, {limit:10})

        myList: ["a","b","c"]

        info: toGrid(myists).round()
        x: round(toGrid(myList)).toStr()

        myString: "llama"

        myString.wrapper(a.parseNumber())

                
        
    --->
  }

  wrapper: Func {foo: Str, bar: Number, returns: Str
  
    <axon:---

        return foo
        
    --->

  }

}