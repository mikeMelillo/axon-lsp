{
  "name": "axon-lsp",
  "displayName": "Axon LSP (Project Haystack)",
  "description": "LSP and Syntax Highlighting for the Axon programming language",
  "version": "0.3.6",
  "publisher": "mikeMelillo",
  "engines": {
    "vscode": "^1.80.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onLanguage:axon",
    "onLanguage:xeto",
    "onLanguage:fantom",
    "onStartupFinished"
  ],
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "axon",
        "aliases": ["Axon", "axon"],
        "extensions": [".trio"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "xeto",
        "aliases": ["Xeto", "xeto"],
        "extensions": [".xeto"]
      },
      {
        "id": "fantom",
        "aliases": ["Fantom", "fantom"],
        "extensions": [".fan"]
      }
    ],
    "grammars": [
      {
        "language": "axon",
        "scopeName": "source.axon",
        "path": "./syntaxes/axon.tmLanguage.json"
      },
      {
        "language": "xeto",
        "scopeName": "source.xeto",
        "path": "./syntaxes/xeto.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Axon LSP",
      "properties": {
        "axonLsp.haxallPaths": {
          "type": "array",
          "default": [],
          "description": "Paths to Haxall installation directories or clone roots. Scanned recursively up to 4 directory levels for .trio and .fan sources."
        },
        "axonLsp.externalPaths": {
          "type": "array",
          "default": [],
          "description": "Additional paths to scan for Axon functions outside the current workspace. Scanned recursively up to 4 directory levels."
        },
        "axonLsp.indexAllWorkspaceFolders": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Index every folder in a multi-root VS Code workspace as local Axon sources. Disabled by default because large workspaces may increase startup time and memory usage."
        },
        "axonLsp.mode": {
          "type": "string",
          "enum": ["auto", "defs", "specs"],
          "default": "auto",
          "description": "Choose whether bundled function metadata prefers legacy defs, newer specs, or decides automatically based on future workspace support."
        },
        "axonLsp.warnMissingArguments": {
          "type": "boolean",
          "default": true,
          "description": "Show diagnostics when a function call omits required arguments."
        }
      }
    },
    "commands": [
        {
            "command": "extension.openExternal",
            "title": "Open External URL"
        }
    ]
  },
  "main": "./client/out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run build:all",
    "compile": "tsc -p ./client",
    "watch": "tsc -watch -p ./client",
    "postinstall": "npm install --prefix client",
    "build:server": "node ./scripts/build-go.mjs",
    "build:server:dev": "node ./scripts/build-go.mjs --host",
    "build:cache": "node ./scripts/build-cache.mjs",
    "test:go": "sh -c 'cd go-server && go test ./...'",
    "bench:go": "sh -c 'cd go-server && go test -run ^$ -bench . -benchmem ./internal/index'",
    "build:all": "npm run compile && npm run build:server",
    "package": "npm run build:all && vsce package -o build",
    "publish": "npm run build:all && vsce publish"
  },
  "devDependencies": {
    "@types/node": "^16.11.7",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.1.6"
  },
  "repository": "https://github.com/mikeMelillo/axon-lsp"
}
